# ============================================================
# pnpm 配置
# ============================================================

# 国内用 npmmirror，装依赖快很多（原仓库 ruoyi-ui 的 README 也是这么建议的）
registry=https://registry.npmmirror.com

# 严格依赖：不提升 node_modules，避免"用了没声明的依赖"这种幽灵依赖
# （老工程就有这个问题：pguide-match-ui 用了 qs / uuid 但 package.json 里没有）
shamefully-hoist=false
strict-peer-dependencies=false

# 提升的类型包白名单：某些 @types 需要被 TS 直接看到
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*

# 依赖版本升级时不要自动改 package.json 的范围
save-prefix=^
