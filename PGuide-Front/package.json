{
  "name": "pguide-front",
  "version": "2.0.0",
  "private": true,
  "description": "项导前端 monorepo（Vue3 + Vite + TypeScript）",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @pguide/match dev",
    "dev:auth": "pnpm --filter @pguide/auth dev",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "build:match": "pnpm --filter @pguide/match build",
    "preview": "pnpm --filter @pguide/match preview",
    "type-check": "pnpm -r type-check",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,vue,json,css,scss,md}\"",
    "format:check": "prettier --check \"{apps,packages}/**/*.{ts,vue,json,css,scss,md}\"",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "clean": "pnpm -r exec rimraf node_modules dist && rimraf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3"
  }
}
