# ============================================================
# 开发环境
#
# 端口固定 99：后端 pguide-auth 的 `pguide.server.path.authPage`
# 配的就是 http://localhost:99/，改了要同步改后端。
# ============================================================

VITE_APP_TITLE = 项导鉴权中心

# 业务接口：同源，由 Vite dev server 代理到网关（无跨域）
VITE_API_BASE_URL = /api

# 本应用地址
VITE_SELF_URL = http://localhost:99/

# 开发代理目标：网关
VITE_PROXY_TARGET = http://localhost:666
