# ============================================================
# 生产环境
#
# `/prod-api` 由 nginx 反向代理到网关。
# VITE_SELF_URL 必须改成真实的鉴权中心域名 —— 后端会把子系统
# 跳转到这里，配错了整个 SSO 就断了。
# ============================================================

VITE_APP_TITLE = 项导鉴权中心

VITE_API_BASE_URL = /prod-api

# 部署时按实际域名覆盖，例如 https://auth.example.com/
VITE_SELF_URL = /
