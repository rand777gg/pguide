{
  "extends": "./tsconfig.app.json",
  "include": ["env.d.ts", "src/**/__tests__/*"],
  "exclude": [],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // 不需要 "jsdom"：jsdom 是 vitest 的**运行时**环境（见 vite.config.ts 的
    // test.environment），不是需要全局注入的类型包。写进去会报
    // TS2688: Cannot find type definition file for 'jsdom'。
    "types": ["node", "vitest/globals"]
  }
}
