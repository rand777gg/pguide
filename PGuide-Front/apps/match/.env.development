# ============================================================
# 开发环境
#
# 老工程是 `.env.development` 里写绝对地址 http://localhost:666/api，
# 属于跨域请求。这里改成同源 `/api` + Vite 代理（见 vite.config.ts），
# 浏览器层面根本不产生跨域。
# ============================================================

VITE_APP_TITLE = 项导组队中心

# 业务接口：同源，由 Vite dev server 代理到网关
VITE_API_BASE_URL = /api

# 鉴权中心：同样是网关下的路径
VITE_AUTH_API_BASE_URL = /api

# 本应用地址（鉴权中心登录后回跳用，必须是绝对地址）
VITE_SELF_URL = http://localhost:4000/

# 开发代理目标：网关
VITE_PROXY_TARGET = http://localhost:666

# 是否启用登录守卫。开发期设为 false 时可以直接看页面，不用先跑通鉴权中心
VITE_AUTH_GUARD = false
