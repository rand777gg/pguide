# ============================================================
# 开发环境
#
# 对接 PGuide-Manage（RuoYi 单体，默认 :8080）。
# 前缀用 /dev-api 并去掉后再转发 —— 因为 RuoYi 的接口在根路径下
# （/login、/getRouters、/system/user/list），不像 PGuide-Back 那样
# 统一挂在 /api 下。详见 vite.config.ts 的说明。
# ============================================================

VITE_APP_TITLE = 项导后台管理系统

VITE_API_BASE_URL = /dev-api

VITE_PROXY_TARGET = http://localhost:8080
