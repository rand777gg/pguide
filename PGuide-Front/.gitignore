# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
dist-ssr/
*.local

# 测试与缓存
coverage/
.vite/
*.tsbuildinfo

# 注意：apps/*/src/types/auto-imports.d.ts 与 components.d.ts **要提交**。
# 它们虽然由 unplugin-* 生成，但 vue-tsc 依赖它们才能识别自动导入的
# ElMessage / el-button 等符号。而 build 脚本里 type-check 和 vite build
# 是并行跑的，首次运行时 dts 还没生成，类型检查会误报
# "Cannot find name 'ElMessage'"。提交这两个文件可以让新克隆和 CI 都稳定通过。

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 日志
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# 说明：下面的老工程目录不在 pnpm workspace 内（见 pnpm-workspace.yaml），
# 它们各自维护自己的 node_modules，不受本文件影响。
